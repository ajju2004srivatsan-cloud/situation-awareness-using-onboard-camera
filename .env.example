# Public hostname or IP for LAN clients.
SERVER_HOST=192.168.0.137
TELEMETRY_PORT=8080
RTMP_PORT=1935
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
STALE_DEVICE_MS=15000
ENABLE_SIMULATOR=0
# Cloudflare HTTPS for dashboard + WSS + HLS
ENABLE_WORLD_TUNNEL=1
# bore.pub TCP so G20 can RTMP from any network
ENABLE_RTMP_TUNNEL=1
