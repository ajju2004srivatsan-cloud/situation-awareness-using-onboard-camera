[Unit]
Description=Situational Awareness demo telemetry simulator
After=sa-telemetry.service
Requires=sa-telemetry.service

[Service]
Type=simple
User=ogden
Group=ogden
WorkingDirectory=/home/ogden/situational-awareness/simulator
EnvironmentFile=-/home/ogden/situational-awareness/.env
Environment=WS_URL=ws://127.0.0.1:8080/ws
ExecStart=/usr/local/bin/node /home/ogden/situational-awareness/simulator/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
